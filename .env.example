# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
# Canonical public URL. Local dev keeps localhost; production MUST be:
# NEXT_PUBLIC_SITE_URL=https://kharb.online
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite file (local dev). Postgres later: DATABASE_URL=postgres://... + PostgresJobStore
DATABASE_URL=file:./data/jobs.db

# Temp storage root -> $TEMP_DIR/jobs/<jobId>/{source,output}
TEMP_DIR=./tmp/converter

# Binaries (Docker image provides all three; locally `which ffmpeg`)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp

# Adapters: subset of "youtube,direct"
ENABLED_ADAPTERS=youtube,direct
# Extra hosts allowed for direct-file adapter (comma-separated, e.g. your own CDN)
ALLOWED_DIRECT_HOSTS=

# Free YouTube fallback when direct yt-dlp download is IP-blocked (HTTP 403
# from googlevideo.com on datacenter IPs). Resolves audio via public
# Piped/Invidious APIs, then downloads the stream. Best-effort: public
# instances rate-limit and come and go — override the lists when one dies.
FALLBACK_ENABLED=true
PIPED_API_URLS=https://pipedapi.kavin.rocks,https://pipedapi.adminforge.de,https://pipedapi.leptons.xyz
INVIDIOUS_API_URLS=https://inv.invidious.nerdvpn.de,https://invidious.nerdvpn.de
FALLBACK_API_TIMEOUT_SEC=10

# Extra argv appended to every yt-dlp call (space-separated, no quoting).
# The Docker image sets Chrome TLS fingerprint + PO-token plugin dir:
# YTDLP_EXTRA_ARGS="--impersonate chrome --plugin-dirs /opt/yt-dlp-plugins"
# Leave empty on machines whose yt-dlp lacks curl_cffi or the plugin.
YTDLP_EXTRA_ARGS=

# Proxy for all yt-dlp traffic. The Docker entrypoint manages this automatically:
# it starts a free Cloudflare WARP proxy and sets YTDLP_PROXY only when a
# YouTube probe through it passes. Set WARP_ENABLED=false to force direct egress.
WARP_ENABLED=true
YTDLP_PROXY=

# Persistent conversion cache (videoId+format+bitrate): repeat downloads serve from
# disk in seconds without touching YouTube. Bounded by size + age.
# CACHE_MAX_MB=0 disables the cache (right for ephemeral free-tier disks
# like Render Free, where cached files never survive restarts anyway).
CACHE_MAX_MB=2000
CACHE_TTL_HOURS=168

# Cooldown breaker: after this many consecutive YouTube upstream failures,
# new YouTube jobs fail fast with "cooling down" for this many minutes
# (hammering a blocking endpoint only deepens throttling).
BREAKER_THRESHOLD=5
BREAKER_COOLDOWN_MIN=30

# Limits (all enforced server-side; tune per host)
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_IP=5
ANALYZE_PER_MIN_PER_IP=20
JOBS_PER_HOUR_PER_IP=10
MAX_INPUT_DURATION_SEC=3600
MAX_FILE_MB=200
JOB_EXPIRATION_MINUTES=30
CLEANUP_INTERVAL_MIN=5
PROCESSING_TIMEOUT_MIN=15
DEFAULT_BITRATE=192

LOG_LEVEL=info

# --- Workers + Render split (free, no card) ---
# Edge -> origin shared secret. The Cloudflare Worker sends it as
# X-Origin-Token; middleware.ts rejects direct /api/* hits without it.
# Empty = enforcement off (local dev). Set the same value on Render
# (ORIGIN_TOKEN) and as a Worker secret (wrangler secret put ORIGIN_TOKEN).
# Render free-tier values: DATABASE_URL=file:/tmp/data/jobs.db,
# TEMP_DIR=/tmp/converter, MAX_CONCURRENT_JOBS=1, MAX_INPUT_DURATION_SEC=1200,
# CACHE_MAX_MB=0, DEFAULT_BITRATE=128, WARP_ENABLED=false. See render.yaml.
ORIGIN_TOKEN=
