{
  "name": "videotomp3",
  "version": "0.1.0",
  "private": true,
  "description": "Convert videos you own or have permission to download into MP3. Next.js + FFmpeg + yt-dlp behind a pluggable adapter.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cleanup": "tsx scripts/cleanup.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "next-themes": "^0.3.0",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  }
}
